{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-limao-azedo",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal-limao-push",
      "database_id": "f353ef57-199d-4c9d-8e87-a92e5249fc42"
    }
  ],

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  "keep_vars": true
}
